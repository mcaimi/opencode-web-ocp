{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "lsp": true,
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "openshift",
      "effect": "allow"
    }
  ],
  "providers": {
    "openshift": {
      "name": "vLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:OPENSHIFT_LLM_INFERENCE_ENDPOINT}",
        "apiKey": "{env:OPENSHIFT_AI_VLLM_API_KEY}"
      },
      "models": {
        "OPENSHIFT_DEPLOYED_MODEL_NAME": {
          "name": "CodingAssistant"
        }
      }
    }
  }
}
